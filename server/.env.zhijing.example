# ============================================================================
# 浙江公安方言语料采集平台 —— 内网部署环境变量模板
#
# 用法：复制为 server/.env（容器部署时也可作为 server/.env.docker 的补充）
#       改完执行 GET /api/auth/zhijing/self-check 或 GET /api/zhijing/info 自检
# 说明：全部变量名大小写不敏感（pydantic-settings 规则），此处统一用大写
# ============================================================================

# ---------- 基础 ----------
# SQLite（本地开发）: sqlite:///./data/app.db
# MySQL（内网上架）  : mysql+pymysql://用户:口令@主机:3306/库名?charset=utf8mb4
DATABASE_URL=sqlite:///./data/app.db
SECRET_KEY=请替换为不少于32位随机串
ACCESS_TOKEN_EXPIRE_HOURS=12

# 前端基地址：子路径部署（如 /record/）时必须写对，认证回调 302 依赖它
FRONTEND_BASE=/

# 允许的前端来源（逗号分隔）。用 nginx 同源反代时可只留本机
CORS_ORIGINS=http://localhost:5173

# ---------- 录音/质检 ----------
AUDIO_STORAGE_PATH=./audio_storage
EXPORT_PATH=./data/exports
ASR_API_URL=
# 扫盘白名单根目录（生产必设，避免任意路径扫描）
SCAN_ROOT=

# ============================================================================
# 浙警智治接入
# ============================================================================
# 对接模式：
#   off  = 纯本地账号密码（默认，未联调前保持）
#   mock = 本地模拟平台身份，可把"免登录进首页 → 审计上报"整链跑通（联调前必备）
#   live = 真机对接
ZHIJING_MODE=off

# 身份来源：
#   dynamic = 统一认证动态秘钥（用户域标准做法：平台把人员信息回调给我们）
#   rzzx    = 零信任令牌信息（RZZX-USERTOKEN / RZZX-APPTOKEN）
#   both    = 先试令牌，再回退动态秘钥参数（默认，联调最稳）
ZHIJING_LOGIN_SOURCE=both

# 过渡期保留手机号+密码登录（true/false）。上架检测前建议置 false，
# 置 false 后仅 super_admin 应急账号可走本地口令。
ZHIJING_LEGACY_LOGIN=true

# 应用身份（资源管理器/上架页面获取，务必与上架材料一致）
ZHIJING_SYS_ID=            # 系统标准码 / requestId：审计、数据编目、智慧运维三处共用
ZHIJING_APP_KEY=           # 应用主键 AK
ZHIJING_APP_SECRET=        # 密钥主键 SK（审计上报的 appSecret 取同一注册密钥）
ZHIJING_DQXTBS=            # 当前系统标识 dqxtbs（留空则回退 SYS_ID）
ZHIJING_AUTH_BUTTON=       # 应用标识 APPID（要显式做应用级鉴权时填）

# 服务地址（用户域省厅地址；地市应用请换成本地科信给的地址）
ZHIJING_RZ_URL=https://lxrdl.gat.zj:5010/jiRMS_RzSer
ZHIJING_QX_URL=https://lxrdl.gat.zj:5020/jiRMS_QxSer
ZHIJING_AUDIT_URL=https://41.188.255.179:9000
ZHIJING_VERIFY_SSL=false   # 内网私有 CA/自签时保持 false；正式证书可置 true
ZHIJING_TIMEOUT=15

# 认证回调地址（上架时在应用管理器"认证配置"里填写同一个路径）
ZHIJING_CALLBACK_PATH=/api/auth/zhijing/callback
ZHIJING_PENDING_TOKEN_MINUTES=10
# 令牌方式未携带令牌时的跳转入口（一般无需改）
ZHIJING_ITRUST_LOGIN_URL=https://lxrdl.gat.zj:5010/jiRMS_RzSer

# 接口路径（若省厅组件调用文档与规范不同，改这里，不动代码）
ZHIJING_PATH_GET_LOGIN_USER=/jyglb/apis/V2/getLoginUser
ZHIJING_PATH_CREATE_APP_TOKEN=/jwt/nologin/V2/202307/createAppToken
ZHIJING_PATH_RENEW_TOKEN=/jwt/nologin/V2/renewOrOfflineToken
ZHIJING_PATH_APP_PERMISSION=/dzRole/V2/202307/jqfw/yyj
ZHIJING_PATH_AUDIT_JSON=/commonApi/logApi_v2/transferJsonLog

# ---------- 审计服务（全部应用必做） ----------
ZHIJING_AUDIT_ENABLED=false        # live 模式必须置 true
ZHIJING_AUDIT_QUEUE_ENABLED=true   # 是否写本地台账（测试可关）
ZHIJING_AUDIT_FLUSH_SECONDS=30
ZHIJING_AUDIT_RETRY_SECONDS=60     # 上报失败后的重推间隔（规范要求失败必须缓存重推）
ZHIJING_AUDIT_BATCH=100            # 单批上限（规范 ≤100）
ZHIJING_AUDIT_MAX_BYTES=1048576    # 单批报文上限（规范 ≤1M）

# ---------- 统一用户/部门同步 ----------
ZHIJING_ORG_SYNC_ENABLED=false
ZHIJING_ORG_SYNC_SECONDS=60        # 规范要求不少于 1 分钟
ZHIJING_USER_DEFAULT_ROLE=user
ZHIJING_ADMIN_POLICE_NUMBERS=      # 逗号分隔警号：这些警号同步为 admin
# 统一用户组件：申请后按"组件调用文档"填基地址与接口路径（留空=不同步）
ZHIJING_ORG_BASE_URL=
ZHIJING_ORG_INIT_PATH=/init
ZHIJING_ORG_DEPT_INCREMENT_PATH=/deptIncrement
ZHIJING_ORG_USER_INCREMENT_PATH=/userIncrement
ZHIJING_ORG_PAGE_SIZE_DEPT=1000    # 规范建议 ≤1000
ZHIJING_ORG_PAGE_SIZE_USER=100     # 规范建议 ≤100
ZHIJING_ORG_HEADERS=               # 额外请求头，JSON 字符串，如 {"X-App":"zjpdt"}

# ---------- 其他 ----------
TEXT_IMPORT_DIR=data/text_imports
AUDIO_IMPORT_DIR=data/audio_imports
