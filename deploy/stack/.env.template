# 用法：cp .env.template .env，然后把三个 <改我> 换成 openssl 生成的随机值
#（install.sh 会自动做这一步；手动部署时才需要自己改）。
# 这是整个部署里唯一必须修改的文件；docker compose 的所有命令都从它取密钥。
#
# 生成命令（密码只用 hex 随机串，勿含 @ : / ? # 等字符——它们会破坏 DATABASE_URL 拼接）：
#   openssl rand -hex 32    # → SECRET_KEY（JWT 签名密钥）
#   openssl rand -hex 16    # → MYSQL_ROOT_PASSWORD、MYSQL_PASSWORD（两个各自生成，不要复用）
#
# 注意：MYSQL_PASSWORD 只在 MySQL 数据卷**首次初始化**时生效（mysql 镜像只认首启密码）；
#       之后改密走 DEPLOY.md §9.3 的 ALTER USER 流程，改这里没用。

SECRET_KEY=<改我：openssl rand -hex 32 的结果>
MYSQL_ROOT_PASSWORD=<改我：openssl rand -hex 16 的结果>
MYSQL_PASSWORD=<改我：openssl rand -hex 16 的结果>

# 对外端口（80/443 被占用时改这里，防火墙/安全组记得放行改后的端口）
HTTP_PORT=80
HTTPS_PORT=443

# ASR 方言转译上游（契约 POST {base}/asr?diarization=false；ASR_VERIFY_SSL 默认 false）。
# 当前默认是内网穿透隧道（vicp.fun），可能漂移失效；换地址 = 改这里后 docker compose up -d 重启 backend。
# 置空 = 质检直通 passed（录音上传不受影响，仅不做转写比对）。
ASR_UPSTREAM_BASE=https://1plxo01525881.vicp.fun
