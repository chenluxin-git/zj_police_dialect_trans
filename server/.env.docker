# 容器运行配置（docker-compose 以 env_file 注入；数据统一落 /data 共享卷）
# 默认 SQLite 联调形态；正式环境切 MySQL：启用 compose --profile mysql 并改用下方注释行
DATABASE_URL=sqlite:////data/app.db
# DATABASE_URL=mysql+pymysql://zjpdt:change-me-in-prod@mysql:3306/zjpdt?charset=utf8mb4
#   主机名 mysql = compose 服务名；改 MYSQL_PASSWORD 时此行须同步；
#   存量 SQLite 数据搬迁见 deploy/README.md「存量数据搬迁」与 docs/offline-deploy.md
AUDIO_STORAGE_PATH=/data/audio_storage
EXPORT_PATH=/data/exports

# JWT——部署前必改（openssl rand -hex 32 生成后替换，或 compose 环境变量 SECRET_KEY 覆盖）
SECRET_KEY=change-me-in-prod
ACCESS_TOKEN_EXPIRE_HOURS=12

# 同源反代下 CORS 其实不触发，保留白名单便于本机 vite dev 直连调试
CORS_ORIGINS=https://localhost,https://127.0.0.1,http://localhost:5173

# ASR 方言转译：留空 = 质检直通 passed（联调就绪后填 BASE 重启 backend 生效）
# 契约对齐 new_tailect：POST {ASR_UPSTREAM_BASE}/asr?diarization=false（ASR_VERIFY_SSL 默认 false）
ASR_UPSTREAM_BASE=
ASR_TIMEOUT=300

QC_SIMILARITY_THRESHOLD=0.5
QC_MAX_RETRY=3
QC_SCAN_INTERVAL=60

# 浙警智治接入：完整键表见 server/.env.zhijing.example（默认全关，不影响本地/联调）
# ZHIJING_MODE=off / mock / live；上架联调时按 docs/deploy-zhijing-onboarding.md 逐项开启

# 侧车台账落卷（容器重建不丢）+ 扫盘白名单根目录（用扫盘前先在卷内建该目录并放入音频）
TEXT_IMPORT_DIR=/data/text_imports
AUDIO_IMPORT_DIR=/data/audio_imports
SCAN_ROOT=/data/scan
