# 应用运行配置（整栈打包版，由 compose 以 env_file 注入；数据统一落 /data 共享卷）
#
# 密钥与数据库连接串**不在本文件**：
#   SECRET_KEY / DATABASE_URL / ASR_UPSTREAM_BASE 由 docker-compose.yml 从包根 .env 插值注入，
#   environment 优先级高于 env_file，想改密钥只动包根 .env 一处即可。

AUDIO_STORAGE_PATH=/data/audio_storage
EXPORT_PATH=/data/exports

ACCESS_TOKEN_EXPIRE_HOURS=12

# 同源反代（web 容器 nginx /api/ → backend:8000）下浏览器请求不跨域，此白名单仅备查
CORS_ORIGINS=https://localhost

ASR_TIMEOUT=300
ASR_VERIFY_SSL=false

QC_SIMILARITY_THRESHOLD=0.5
QC_MAX_RETRY=3
QC_SCAN_INTERVAL=60

# 浙警智治接入默认全关（本部署用本地账号体系；日后上架再按 docs/deploy-zhijing-onboarding.md 逐项开启）
ZHIJING_MODE=off

# 导入/扫盘运行目录（容器内指向 /data 卷，台账不落容器临时层）
TEXT_IMPORT_DIR=/data/text_imports
AUDIO_IMPORT_DIR=/data/audio_imports
SCAN_ROOT=/data/scan
