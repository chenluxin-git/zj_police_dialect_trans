# 后端容器生产环境配置（浙警智治上架）
#
# 用法：复制为 server/.env.docker 后按注释填写；compose 以 env_file 注入。
# 与 server/.env.zhijing.example 的关系：
#   本文件 = 容器内**路径/开关**口径（数据落 /data 卷）
#   .env.zhijing.example = 浙警智治接入参数的完整说明与含义

# ---------- 数据库（正式环境用 MySQL；联调可先用 SQLite 卷） ----------
# MySQL 由 compose 的 mysql profile 提供，主机名即服务名 mysql
DATABASE_URL=mysql+pymysql://zjpdt:请改强口令@mysql:3306/zjpdt?charset=utf8mb4
# DATABASE_URL=sqlite:////data/app.db

# ---------- 存储路径（统一落 /data 共享卷，容器重建不丢） ----------
AUDIO_STORAGE_PATH=/data/audio_storage
EXPORT_PATH=/data/exports
TEXT_IMPORT_DIR=/data/text_imports
AUDIO_IMPORT_DIR=/data/audio_imports
SCAN_ROOT=/data/scan

# ---------- 会话密钥（部署前必改：openssl rand -hex 32） ----------
SECRET_KEY=change-me-in-prod
ACCESS_TOKEN_EXPIRE_HOURS=12
CORS_ORIGINS=https://localhost,https://127.0.0.1,http://localhost:5173
# 子路径部署（如 /record/）时必须写对：认证回调 302 依赖它
FRONTEND_BASE=/

# ---------- 质检（ASR 接口未配置时直通 passed） ----------
ASR_API_URL=
ASR_TIMEOUT=30
QC_SIMILARITY_THRESHOLD=0.5
QC_MAX_RETRY=3
QC_SCAN_INTERVAL=60

# ============================================================================
# 浙警智治接入（详细含义见 server/.env.zhijing.example）
# ============================================================================
# off=纯本地账号 / mock=本地模拟身份（联调前先把链路跑通）/ live=真机对接
ZHIJING_MODE=mock
ZHIJING_LOGIN_SOURCE=both
ZHIJING_LEGACY_LOGIN=true

ZHIJING_SYS_ID=
ZHIJING_APP_KEY=
ZHIJING_APP_SECRET=
ZHIJING_DQXTBS=
ZHIJING_AUTH_BUTTON=

ZHIJING_RZ_URL=https://lxrdl.gat.zj:5010/jiRMS_RzSer
ZHIJING_QX_URL=https://lxrdl.gat.zj:5020/jiRMS_QxSer
ZHIJING_AUDIT_URL=https://41.188.255.179:9000
ZHIJING_VERIFY_SSL=false
ZHIJING_TIMEOUT=15

ZHIJING_CALLBACK_PATH=/api/auth/zhijing/callback
ZHIJING_PENDING_TOKEN_MINUTES=10
ZHIJING_ITRUST_LOGIN_URL=https://lxrdl.gat.zj:5010/jiRMS_RzSer

ZHIJING_AUDIT_ENABLED=false
ZHIJING_AUDIT_QUEUE_ENABLED=true
ZHIJING_AUDIT_FLUSH_SECONDS=30
ZHIJING_AUDIT_RETRY_SECONDS=60
ZHIJING_AUDIT_BATCH=100
ZHIJING_AUDIT_MAX_BYTES=1048576

ZHIJING_ORG_SYNC_ENABLED=false
ZHIJING_ORG_SYNC_SECONDS=60
ZHIJING_USER_DEFAULT_ROLE=user
ZHIJING_ADMIN_POLICE_NUMBERS=
ZHIJING_ORG_BASE_URL=
ZHIJING_ORG_INIT_PATH=/init
ZHIJING_ORG_DEPT_INCREMENT_PATH=/deptIncrement
ZHIJING_ORG_USER_INCREMENT_PATH=/userIncrement
ZHIJING_ORG_PAGE_SIZE_DEPT=1000
ZHIJING_ORG_PAGE_SIZE_USER=100
ZHIJING_ORG_HEADERS=

# 接口路径（若省厅组件调用文档与规范不同，改这里，不动代码）
ZHIJING_PATH_GET_LOGIN_USER=/jyglb/apis/V2/getLoginUser
ZHIJING_PATH_CREATE_APP_TOKEN=/jwt/nologin/V2/202307/createAppToken
ZHIJING_PATH_RENEW_TOKEN=/jwt/nologin/V2/renewOrOfflineToken
ZHIJING_PATH_APP_PERMISSION=/dzRole/V2/202307/jqfw/yyj
ZHIJING_PATH_AUDIT_JSON=/commonApi/logApi_v2/transferJsonLog
